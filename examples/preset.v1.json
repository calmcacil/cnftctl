{
  "version": 1,
  "wan_interface": "eth0",
  "open_ports": [],
  "ssh": {
    "mode": "open",
    "static_whitelist": {
      "ipv4": [
        {
          "value": "203.0.113.10",
          "comment": "example administrator"
        }
      ],
      "ipv6": [
        {
          "value": "2001:db8::10",
          "comment": "example IPv6 administrator"
        }
      ]
    },
    "ddns_whitelist": {
      "enabled": false,
      "hosts": [
        "home.example.com"
      ],
      "ttl": "1h",
      "refresh_interval": "5m",
      "ipv6_prefix_len": 56
    }
  },
  "trusted_interfaces": {
    "enabled": false,
    "interfaces": [
      "tailscale0"
    ],
    "trust_forwarding": false
  },
  "docker": {
    "enabled": false,
    "interfaces": [
      "docker0",
      "br-*"
    ]
  }
}
