#!/bin/sh

# WARNING: UNSUPPORTED REFERENCE ONLY. Do not execute or install this script as
# part of a cnftctl deployment; use only a verified canonical release bundle.
# Resolve configured DDNS hostnames and add their A/AAAA records to nftables
# runtime SSH whitelist sets.
#
# This script does not reload nftables. Entries are added with a timeout, so old
# addresses expire automatically if DNS changes or updates stop.

set -eu

CONFIG_FILE="/etc/nftables.d/ddns-hosts.conf"
TABLE_FAMILY="inet"
TABLE_NAME="hostfw"
SET_V4="ddns_whitelist_v4"
SET_V6="ddns_whitelist_v6"
TTL="1h"
# Prefix length delegated by the ISP via DHCPv6-PD.
# For your EdgeRouter setup this is /56; the router then assigns /64s to LANs.
IPV6_PREFIXLEN="56"

log() {
    printf '%s\n' "nft-ddns-whitelist: $*" >&2
}

if ! command -v nft >/dev/null 2>&1; then
    log "nft command not found"
    exit 1
fi

if ! command -v getent >/dev/null 2>&1; then
    log "getent command not found"
    exit 1
fi

if ! command -v awk >/dev/null 2>&1; then
    log "awk command not found"
    exit 1
fi

if ! command -v sort >/dev/null 2>&1; then
    log "sort command not found"
    exit 1
fi

if [ ! -r "$CONFIG_FILE" ]; then
    log "config file not found or not readable: $CONFIG_FILE"
    exit 1
fi

# Confirm the expected sets exist. If nftables was not loaded yet, fail loudly so
# systemd can retry on the next timer run.
if ! nft list set "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V4" >/dev/null 2>&1; then
    log "nft set not found: $TABLE_FAMILY $TABLE_NAME $SET_V4"
    exit 1
fi

if ! nft list set "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V6" >/dev/null 2>&1; then
    log "nft set not found: $TABLE_FAMILY $TABLE_NAME $SET_V6"
    exit 1
fi

FOUND_HOSTS="no"
REFRESHED="no"

while IFS= read -r line || [ -n "$line" ]; do
    # Trim leading/trailing whitespace using awk for POSIX sh portability.
    host=$(printf '%s\n' "$line" | awk '{$1=$1; print}')

    case "$host" in
        ""|\#*)
            continue
            ;;
    esac

    FOUND_HOSTS="yes"

    for ip in $(getent ahostsv4 "$host" 2>/dev/null | awk '{ print $1 }' | sort -u); do
        [ -n "$ip" ] || continue

        # Only accept dotted-quad IPv4 addresses. Some resolver modes can return
        # IPv4-mapped IPv6 addresses, which do not belong in the IPv4 set.
        case "$ip" in
            *:*)
                continue
                ;;
        esac

        # Delete first so the timeout is refreshed if the element already exists.
        nft delete element "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V4" "{ $ip }" 2>/dev/null || true

        if nft add element "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V4" "{ $ip timeout $TTL }" 2>/dev/null; then
            REFRESHED="yes"
        else
            log "failed to add IPv4 address for $host: $ip"
        fi
    done

    for ip in $(getent ahostsv6 "$host" 2>/dev/null | awk '{ print $1 }' | sort -u); do
        [ -n "$ip" ] || continue

        # Only accept real IPv6 addresses. Exclude IPv4-mapped addresses such as
        # ::ffff:192.0.2.10 that glibc may synthesize when no AAAA record exists.
        case "$ip" in
            ::ffff:*|::FFFF:*|*.*)
                continue
                ;;
            *:*)
                ;;
            *)
                continue
                ;;
        esac

        # Whitelist the delegated IPv6 prefix derived from the resolved home IPv6
        # address, not just the single temporary/privacy /128 address.
        # Supports the common DHCPv6-PD /56 case and single-LAN /64 case without
        # requiring Python or external IPv6 calculator packages.
        prefix=$(awk -v ip="$ip" -v plen="$IPV6_PREFIXLEN" '
            function lower(s) { return tolower(s) }
            function pad4(s) { s = lower(s); while (length(s) < 4) s = "0" s; return s }
            function trim0(s) { s = lower(s); sub(/^0+/, "", s); return s == "" ? "0" : s }
            function count_parts(s, arr) { if (s == "") return 0; return split(s, arr, ":") }
            function expand_ipv6(addr, out,    halves,left,right,nl,nr,zeros,i,j) {
                sub(/%.*/, "", addr)
                addr = lower(addr)

                if (addr ~ /\./) return 0

                if (index(addr, "::") > 0) {
                    split(addr, halves, "::")
                    nl = count_parts(halves[1], left)
                    nr = count_parts(halves[2], right)
                    zeros = 8 - nl - nr
                    if (zeros < 1) return 0

                    j = 1
                    for (i = 1; i <= nl; i++) out[j++] = pad4(left[i])
                    for (i = 1; i <= zeros; i++) out[j++] = "0000"
                    for (i = 1; i <= nr; i++) out[j++] = pad4(right[i])
                } else {
                    if (split(addr, out, ":") != 8) return 0
                    for (i = 1; i <= 8; i++) out[i] = pad4(out[i])
                }

                return 1
            }
            BEGIN {
                if (!expand_ipv6(ip, h)) exit 1

                if (plen == 56) {
                    h[4] = substr(h[4], 1, 2) "00"
                    print trim0(h[1]) ":" trim0(h[2]) ":" trim0(h[3]) ":" trim0(h[4]) "::/56"
                    exit 0
                }

                if (plen == 64) {
                    print trim0(h[1]) ":" trim0(h[2]) ":" trim0(h[3]) ":" trim0(h[4]) "::/64"
                    exit 0
                }

                exit 1
            }
        ' 2>/dev/null || true)

        if [ -z "$prefix" ]; then
            log "failed to derive IPv6 /$IPV6_PREFIXLEN prefix for $host: $ip"
            continue
        fi

        # Delete first so the timeout is refreshed if the element already exists.
        nft delete element "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V6" "{ $prefix }" 2>/dev/null || true

        if nft add element "$TABLE_FAMILY" "$TABLE_NAME" "$SET_V6" "{ $prefix timeout $TTL }" 2>/dev/null; then
            REFRESHED="yes"
        else
            log "failed to add IPv6 prefix for $host: $prefix"
        fi
    done
done < "$CONFIG_FILE"

if [ "$FOUND_HOSTS" = "no" ]; then
    log "no hostnames configured in $CONFIG_FILE"
elif [ "$REFRESHED" = "no" ]; then
    log "processed configured hostname(s), but no A/AAAA records were added"
else
    log "processed configured hostname(s), refreshed resolved address record(s)"
fi
